# ===== CẤU HÌNH API =====

# Partner key từ nhà cung cấp API
PARTNER_KEY=your_partner_key_here

# ID của đối tác
PARTNER_ID=your_partner_id_here

# Domain API chung cho tất cả chức năng (ĐỔI THẺ, MUA THẺ, NẠP TOPUP)
DOMAIN=http://api.example.com

# ===== CẤU HÌNH DOMAIN RIÊNG (Tùy chọn) =====
# Nếu các chức năng dùng domain khác nhau, xóa dấu # trước dòng cần điền:

# Domain cho ĐỔI THẺ (nếu khác với DOMAIN)
# DOMAIN_POST=http://card-exchange-api.com

# Domain cho MUA THẺ (nếu khác với DOMAIN)
# DOMAIN_BUY=https://buy-card-api.com

# Domain cho NẠP TOPUP (nếu khác với DOMAIN)
# DOMAIN_TOPUP=http://topup-api.com

# ===== CÀI ĐẶT NÂNG CAO =====

# Timeout cho request (milliseconds)
REQUEST_TIMEOUT=30000

# Môi trường (development, production)
NODE_ENV=development

# Log level (error, warn, info, debug)
LOG_LEVEL=info

